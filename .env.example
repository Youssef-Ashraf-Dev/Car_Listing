# Azure OpenAI Configuration - https://learn.microsoft.com/en-us/azure/ai-services/openai/reference
AZURE_OPENAI_DEPLOYMENT_NAME="your-deployment-name"
AZURE_OPENAI_API_VERSION="2023-05-15"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_API_KEY="your-api-key"

# Email Configuration - For sending the processed listings
# Note: For Gmail, you must use an App Password, not your regular account password.
# See: https://support.google.com/accounts/answer/185833
GMAIL_SENDER_EMAIL="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-digit-app-password"
GMAIL_RECIPIENT_EMAIL="recipient-email@example.com"
